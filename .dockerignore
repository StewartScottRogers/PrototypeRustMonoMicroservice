# Keep the build context small: it is sent to the daemon on every build, and
# a stale host target/ directory would also poison the container's cache.
target/
.git/
.github/
.claude/
.vs/
data/
*.cmd
*.slnx
**/*.shproj
**/*.projitems
**/*.md
# The Visual Studio F5 launcher. No image needs it, and its bin/ and obj/
# would otherwise be sent to the daemon on every one of the eight builds.
DevConsole/
