<?xml version="1.0" encoding="utf-8"?>
<!--
  Viewer-only shared project for written documentation.

  The documents live in docs/ so they are findable from the repository root and
  could be served by GitHub Pages without moving. This project links to them,
  the same arrangement as Cargo/ and DevEnvironment/.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a61ec11a-570b-47e4-9f1b-e4b2101c6108</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Documentation</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\docs\messaging-and-eventing.html" Link="messaging-and-eventing.html" />
  </ItemGroup>
</Project>
