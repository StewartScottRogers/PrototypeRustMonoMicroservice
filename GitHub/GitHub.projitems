<?xml version="1.0" encoding="utf-8"?>
<!--
  Viewer-only shared project for the GitHub Actions configuration.

  The files stay under .github/ because that is the only place GitHub reads
  them from. This project links to them so they are reachable without leaving
  Visual Studio.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a6b0514d-35db-4169-9a5e-da72765eb93b</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>GitHub</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\.github\dependabot.yml" Link="dependabot.yml" />
    <None Include="$(MSBuildThisFileDirectory)..\.github\workflows\ci.yml" Link="workflows\ci.yml" />
    <None Include="$(MSBuildThisFileDirectory)..\.github\workflows\image.yml" Link="workflows\image.yml" />
    <None Include="$(MSBuildThisFileDirectory)..\.github\actions\setup-rust\action.yml" Link="actions\setup-rust\action.yml" />
    <None Include="$(MSBuildThisFileDirectory)..\.github\scripts\affected-crates.sh" Link="scripts\affected-crates.sh" />
    <None Include="$(MSBuildThisFileDirectory)..\.github\scripts\binary-crates.sh" Link="scripts\binary-crates.sh" />
  </ItemGroup>
</Project>
